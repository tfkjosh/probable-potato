# Shopify store domain (without https://)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Private Storefront API token from Shopify Admin / Headless channel
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=your-private-storefront-token

# Shopify Storefront API version
SHOPIFY_API_VERSION=2026-10

# Shopify Customer Account API (public client)
# Use the same store domain as SHOPIFY_STORE_DOMAIN above.
SHOPIFY_CUSTOMER_ACCOUNT_API_CLIENT_ID=your-customer-account-client-id
SHOPIFY_CUSTOMER_ACCOUNT_API_REDIRECT_URI=http://localhost:3000/api/auth/shopify/callback
# customer_write_customers is required for customerUpdate profile mutations.
SHOPIFY_CUSTOMER_ACCOUNT_API_SCOPES=openid email customer-account-api:full customer_write_customers

# Supabase community backend (used by the upcoming SSR integration)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
